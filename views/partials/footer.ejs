<div id="mapModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:2000;">
  <div style="background:#fff;width:90%;max-width:600px;margin:5vh auto;border-radius:12px;overflow:hidden;">

    <div style="padding:16px 20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">
      <h3 style="margin:0;">Set Your Location</h3>
      <button onclick="closeMapModal()" style="background:none;border:none;font-size:24px;cursor:pointer;">×</button>
    </div>

    <div style="padding:16px 20px;">
      <input type="text" id="modalSearchInput" placeholder="Search area, landmark, pincode..." style="width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;margin-bottom:12px;">
      <div id="modalMap" style="height:400px;border-radius:8px;"></div>
      <p style="font-size:12px;color:#777;margin:10px 0;">📍 Map pe click ya marker drag karke exact location set karo</p>
      <p id="modalAddressPreview" style="font-size:13px;color:#333;background:#f4f4f4;padding:10px;border-radius:8px;min-height:20px;"></p>
    </div>

    <div style="padding:16px 20px;border-top:1px solid #eee;text-align:right;">
      <button onclick="confirmMapLocation()" class="btn primary-btn">Confirm Location</button>
    </div>

  </div>
</div>

<script src="/js/app.js"></script>
</body>
</html>